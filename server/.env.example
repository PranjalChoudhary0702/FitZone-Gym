# FitZone Gym Server Environment Variables Template
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/fitzone_gym
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Admin PIN & JWT Authentication
ADMIN_PIN=7788
JWT_SECRET=fitzone_secret_key_2026_super_secure_token
JWT_EXPIRES_IN=24h

# Automatic Database Seeding
AUTO_SEED=true

# Brevo (Sendinblue) SMTP Configuration
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login_email@example.com
SMTP_PASS=your_brevo_smtp_key
EMAIL_FROM="FitZone Gym" <info@fitzonegym.com>
